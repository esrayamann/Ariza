
@model Ariza.Models.LoginViewModel
@{
    ViewData["Title"] = "Giriş Yap";
}
@{
	Layout = null;
}



<!DOCTYPE html>
<html lang="tr">
<head>
	<title>Giriş Yap</title>
	<!-- metatags-->
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
	<meta name="keywords" content="wedlock register form a Flat Responsive Widget,Login form widgets, Sign up Web forms , Login signup Responsive web form,Flat Pricing table,Flat Drop downs,Registration Forms,News letter Forms,Elements" />
	<script type="application/x-javascript">
		 addEventListener("load", function() { setTimeout(hideURLbar, 0); }, false);
		function hideURLbar(){ window.scrollTo(0,1); } </script>
	<!-- Meta tag Keywords -->
	<!-- css -->
	<link rel="stylesheet" href="~/web1/css/style.css" type="text/css" media="all" />
	<!--// css -->
	<link href="~/web1///fonts.googleapis.com/css?family=Cabin" rel="stylesheet">
	<link href="~/web1///fonts.googleapis.com/css?family=Titillium+Web" rel="stylesheet">
	<link href="~/web1///fonts.googleapis.com/css?family=Philosopher" rel="stylesheet">
</head>
<body>
	<section class="agile-header">
		<div class="agile-heading">
			<h1><span class="image"></span><label>T</label>eknik <label>S</label>ervis <label>A</label>rıza <label>T</label>alep <label>F</label>ormu</h1>
		</div>
		<div class="agile-form">
			<form asp-action="Index" method="post">
				@Html.AntiForgeryToken()
				<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
				<div class="agile-email">
					<p>E-posta adresi</p>
					<input asp-for="Email" type="email" class="email" placeholder="ornek@kurum.com" autocomplete="email">
					<span asp-validation-for="Email" class="text-danger"></span>
				</div>
				<div class="agile-password">
					<p>Şifre</p>
					<input asp-for="Password" class="password" placeholder="Şifreniz" autocomplete="current-password">
					<span asp-validation-for="Password" class="text-danger"></span>
				</div>
				<div class="agile-submit">
					<input type="submit" value="Giriş Yap">
				</div>
				
			</form>
		</div>
		<div class="clear"></div>
		<footer>
		</footer>

	</section>

</body>
</html>

