
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>SDÜ Teknik Servis - @ViewBag.Title</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    @await RenderSectionAsync("Styles", required: false)
    <style>
        .navbar {
            box-shadow: 0 2px 5px 0 rgba(0,0,0,.05);
        }
    

        .sidebar .nav-link {
            color: #495057;
            padding: .8rem 1.5rem;
            transition: all 0.2s ease;
        }

            .sidebar .nav-link:hover {
                background-color: #f8f9fa;
                color: #000;
            }

            .sidebar .nav-link.active {
                background-color: #f8f9fa;
                color: #000;
                font-weight: 500;
            }

            .sidebar .nav-link i {
                color: #6c757d;
            }

            .sidebar .nav-link:hover i {
                color: #000;
            }
    </style>
</head>
<body>
    <div class="d-flex">
        <!-- Sidebar -->
        <nav class="sidebar bg-light border-end" style="width: 280px; min-height: 100vh;">
            <div class="p-3 border-bottom">
                <div class="d-flex align-items-center gap-2">
                    <div@*  class="rounded-circle bg-secondary bg-opacity-10 p-3" *@>
                        <i class="bi bi-person-circle fs-4 text-secondary"></i>
                    </div>
                    <div>
                        <h6 class="mb-0">@User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value</h6>
                        <small class="text-muted">Yönetici</small>
                    </div>
                </div>
            </div>

            <div class="p-3">
                <ul class="nav flex-column gap-2">
                    <li class="nav-item">
                        <a href="/Admin/ApplicationList/" class="nav-link rounded d-flex align-items-center gap-2">
                            <i class="bi bi-house-door"></i>
                            Ana Sayfa
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="/Admin/UserList/" class="nav-link rounded d-flex align-items-center gap-2">
                            <i class="bi bi-people"></i>
                            Kullanıcı Listesi
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="/Admin/Rapor/" class="nav-link rounded d-flex align-items-center gap-2">
                            <i class="bi bi-file-earmark-text"></i>
                            Raporlar
                        </a>
                    </li>
                </ul>
            </div>

            <div class="mt-auto p-3 border-top">
                <form asp-action="Index" asp-controller="Login" method="post">
                    <button type="submit" class="btn btn-outline-danger w-100 d-flex align-items-center justify-content-center gap-2">
                        <i class="bi bi-box-arrow-right"></i>
                        Oturumu Kapat
                    </button>
                </form>
            </div>
        </nav>

        <div class="flex-grow-1">
            <!-- Header -->
            <header class="bg-white border-bottom px-4 py-3">
                <div class="d-flex align-items-center justify-content-between">
                    <h4 class="mb-0">
       @*                  <img src="https://w3.sdu.edu.tr/assets/img/logo.png" alt="SDÜ Logo" height="40" class="me-2"> *@
                        Süleyman Demirel Üniversitesi
                    </h4>
                    <div class="text-muted">Teknik Servis Yönetim Paneli</div>
                </div>
            </header>

            <!-- Page Content -->
            <main class="p-4">
                @RenderBody()

            </main>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
   
    @await RenderSectionAsync("Scripts", required: false)

</body>
<script src="~/js/print.js"></script>

<script src="~/js/admin/navigation.js"></script>
</html>