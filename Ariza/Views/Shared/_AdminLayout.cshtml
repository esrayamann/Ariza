@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<title>Teknik Servis</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="stylesheet" href="https://www.w3schools.com/w3css/4/w3.css">
<body>

    <!-- Sidebar -->
    <div class="w3-sidebar w3-light-grey w3-bar-block" style="width:13%">
        <h3 class="w3-bar-item">
            @User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value
        </h3>
        <a href="/Admin/ApplicationList/" class="w3-bar-item w3-button">Ana Sayfa</a>
        <a href="/Admin/UserList/" class="w3-bar-item w3-button">Kullanıcı Listesi</a>
        <a href="/Admin/Rapor/" class="w3-bar-item w3-button">Raporlar</a>
        <form asp-action="Index" asp-controller="Login" method="post" class="form-inline">
            <button type="submit" class="btn btn-link">Oturumu Kapat</button>
        </form>
    </div>

    <!-- Page Content -->
    <div style="margin-left:13%">

        <div class="w3-container w3-teal">
            <h1>Süleyman Demirel Üniversitesi</h1>
        </div>


        <div class="w3-container">
            @RenderBody()
        </div>
    </div>

    @RenderSection("Scripts", required: false)

    <script>
        $(document).ready(function () {
            $('#SicilNo').on('change', function () {
                var sicilNo = $(this).val();

                if (sicilNo) {
                    $.ajax({
                        url: '/Talep/GetTalepInfo',
                        type: 'GET',
                        data: { sicilNo: sicilNo },
                        success: function (response) {
                            if (response.success) {
                                $('#Bolum').val(response.data.Bolum);
                                $('#Birim').val(response.data.Birim);
                                $('#Ad').val(response.data.Ad);
                                $('#Soyad').val(response.data.Soyad);
                                $('#TelNo').val(response.data.TelNo);
                                $('#Ariza').val(response.data.Ariza);
                            } else {
                                alert(response.message);
                            }
                        },
                        error: function () {
                            alert("Bir hata oluştu. Lütfen tekrar deneyin.");
                        }
                    });
                }
            });
        });
    </script>
</body>
</html>
