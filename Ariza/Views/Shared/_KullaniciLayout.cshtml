@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<title>Ana Sayfa</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="stylesheet" href="https://www.w3schools.com/w3css/4/w3.css">
<body>

    <!-- Sidebar -->
    <div class="w3-sidebar w3-light-grey w3-bar-block" style="width:25%">
        <h3 class="w3-bar-item">Menüler</h3>
        <a href="/Talep/Create/" class="w3-bar-item w3-button">Arıza Talep</a>
        <a href="/Talep/MyApplications/" class="w3-bar-item w3-button">Taleplerim</a>   
       <form asp-action="Index" asp-controller="Login" method="post" class="form-inline">
            <button type="submit" class="btn btn-link">Oturumu Kapat</button>
        </form>

    </div>

    <!-- Page Content -->
    <div style="margin-left:25%">

        <div class="w3-container w3-teal">
            <h1>Teknik Servis</h1>
        </div>


        <div class="w3-container">
            @RenderBody()
        </div>

    </div>

</body>
</html>
