@model List<Ariza.Models.Talep>

@{
    ViewData["Title"] = "Başvurularım";
    Layout = "~/Views/Shared/_KullaniciLayout.cshtml";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col">
            <div class="d-flex justify-content-between align-items-center">
                <h2 class="mb-0">
                    <i class="bi bi-list-check me-2"></i>Başvurularım
                </h2>
                <div class="d-flex gap-2">
                    <button class="btn btn-primary" onclick="location.href='@Url.Action("Create", "Talep")'">
                        <i class="bi bi-plus-lg me-2"></i>Yeni Başvuru
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">#</th>
                            <th scope="col">Başvuru Nedeni</th>
                            <th scope="col">Fakülte</th>
                            <th scope="col">Birim</th>
                            <th scope="col">İletişim</th>
                            <th scope="col">Tarih</th>
                            <th scope="col" class="text-center">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var talep in Model)
                        {
                            <tr>
                                <td>@talep.Id</td>
                                <td>
                                    <div class="text-truncate" style="max-width: 200px;" title="@talep.Ariza">
                                        @talep.Ariza
                                    </div>
                                </td>
                                <td>@talep.Bolum</td>
                                <td>@talep.Birim</td>
                                <td>
                                    <div>
                                        <i class="bi bi-telephone me-1"></i>@talep.TelNo
                                    </div>
                                    <div class="small text-muted">
                                        <i class="bi bi-envelope me-1"></i>@talep.Email
                                    </div>
                                </td>
                                <td>
                                    <div>@talep.CreatedDate.ToString("dd.MM.yyyy")</div>
                                    <small class="text-muted">@talep.CreatedDate.ToString("HH:mm")</small>
                                </td>
                                <td class="text-center">
                                    <div class="btn-group">
                                        <a href="@Url.Action("Edit", "Talep", new { id = talep.Id })"
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <button type="button"
                                                class="btn btn-sm btn-outline-secondary"
                                                onclick="printRow(this)">
                                            <i class="bi bi-printer"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        .table > :not(caption) > * > * {
            padding: 1rem 0.75rem;
        }

        .card {
            border-radius: 0.5rem;
            border: none;
        }

        .btn-group .btn {
            padding: 0.375rem 0.5rem;
        }
       
    </style>
}