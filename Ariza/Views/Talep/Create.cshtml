@model Ariza.Models.Talep

@{
    ViewData["Title"] = "Talep Oluştur";
    Layout = "~/Views/Shared/_KullaniciLayout.cshtml";
}

<h2>Talep Oluştur</h2>

<html>
<head>
    <style>
        table, td, th {
            border: 1px solid #ddd;
            text-align: left;
        }

        table {
            border-collapse: collapse;
            width: 60%; 
            margin: 20px auto; 
        }

        th, td {
            padding: 15px;
        }

        th {
            background-color: white;
        }

        button {
            background-color: #549386;
            color: white;
            padding: 10px 20px;
            border: none;
            cursor: pointer;
        }

            button:hover {
                background-color: #549386;
            }
    </style>
</head>
<body>
    <form asp-action="Create" method="post">
        <table>
            <tr>
                <th>Alan</th>
                <th>Bilgi</th>
            </tr>
            <tr>
                <td><label for="Ad">Ad</label></td>
                <td>
                    <input type="text" asp-for="Ad" style="width: 100%;" readonly />
                    <span asp-validation-for="Ad" style="color: red;"></span>

                </td>
            </tr>
            <tr>
                <td><label for="Soyad">Soyad</label></td>
                <td>
                    <input type="text" asp-for="Soyad" style="width: 100%;" readonly />
                    <span asp-validation-for="Soyad" style="color: red;"></span>

                </td>
            </tr>
            <tr>
                <td><label for="SicilNo">Sicil Numarası</label></td>
                <td>
                    <input type="text" asp-for="SicilNo" style="width: 100%;"/>
                    <span asp-validation-for="SicilNo" style="color: red;"></span>
                </td>
            </tr>
            <tr>
                <td><label for="Ariza">Arıza Açıklaması</label></td>
                <td>
                    <input type="text" asp-for="Ariza" style="width: 100%;" />
                    <span asp-validation-for="Ariza" style="color: red;"></span>
                </td>
            </tr>
            <tr>
                <td><label for="Bolum">Bölüm</label></td>
                <td>
                    <input type="text" asp-for="Bolum" style="width: 100%;" />
                    <span asp-validation-for="Bolum" style="color: red;"></span>
                </td>
            </tr>
            <tr>
                <td><label for="Birim">Birim</label></td>
                <td>
                    <input type="text" asp-for="Birim" style="width: 100%;" />
                    <span asp-validation-for="Birim" style="color: red;"></span>
                </td>
            </tr>
            <tr>
                <td><label for="TelNo">Telefon Numarası</label></td>
                <td>
                    <input type="tel" asp-for="TelNo" style="width: 100%;" />
                    <span asp-validation-for="TelNo" style="color: red;"></span>
                </td>
            </tr>
            <tr>
                <td><label for="Email">Email</label></td>
                <td>
                    <input type="email" asp-for="Email" style="width: 100%;" readonly />
                    <span asp-validation-for="Email" style="color: red;"></span>

                </td>
            </tr>
            <tr>
                <td><label for="Ilgilenen">İlgilenen Kişi</label></td>
                <td>
                    <input type="text" asp-for="Ilgilenen" style="width: 100%;" />
                    <span asp-validation-for="Ilgilenen" style="color: red;"></span>
                </td>
            </tr>
            <tr>
                <td><label for="Durum">Durum</label></td>
                <td>
                    <input type="text" asp-for="Durum" style="width: 100%;" />
                    <span asp-validation-for="Durum" style="color: red;"></span>
                </td>
            </tr>
        </table>

        <div style="text-align: center; margin-top: 20px;">
            <button type="submit">Talep Gönder</button>
        </div>
        @if (TempData["SuccessMessage"] != null)
        {
            <div style="color: green; text-align: center; margin-bottom: 20px;">
                @TempData["SuccessMessage"]
            </div>
        }

    </form>
</body>
@if (ViewBag.Errors != null)
{
    <div style="color:red;">
        @foreach (var error in ViewBag.Errors)
        {
            <p>@error</p>
        }
    </div>
}
</html>
