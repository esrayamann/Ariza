@model List<Talep>

@{
    ViewData["Title"] = "ApplicationList";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h1>Talepler </h1>

<form method="get">
    <div>
        <input type="text" name="searchString" placeholder="İsim Soyisim Ara" value="@Context.Request.Query["searchString"]" />
        <button type="submit">Ara</button>
    </div>
</form>


<html>
<head>
    <style>
        table, td, th {
            border: 1px solid #ddd;
            text-align: left;
        }


        table {
            border-collapse: collapse;
            width: 80%; 
            margin: 20px auto; 
        }

        th, td {
            padding: 15px;
        }

        th {
            background-color: #f4f4f4;
        }

        tr:nth-child(even) {
            background-color: #f9f9f9;
        }

        tr:hover {
            background-color: #e0f7fa;
        }

        .container {
            margin-top: 30px;
            text-align: center;
        }
    </style>
</head>
<body>

    <div class="container">
        <table>
            <thead>
                <tr>
                    <th>Ad Soyad</th>
                    <th>İletişim</th>                   
                    <th>Birim</th>
                    <th>Tarih</th>
                    <th>Detay</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var talep in Model)
                {
                    <tr>
                        <td>@talep.Ad @talep.Soyad</td>
                        <td>@talep.TelNo</td>
                                            
                        <td>@talep.Birim</td>                      
                        <td>@talep.CreatedDate</td>
                        <td>
                            <button type="button" onclick="printRow(this)">Yazdır</button>
                            <button onclick="location.href='@Url.Action("Edit", "Talep", new { id = talep.Id })'">Detay</button>

@*                             <button type="button">Detay</button>
 *@                        </td>                        
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <script>
        function printRow(button) {
            // Seçilen satırı al
            var row = button.closest('tr').innerHTML;

            // Yeni bir yazdırma penceresi oluştur
            var printWindow = window.open('', '', 'height=600,width=800');
            printWindow.document.write('<html><head><title>Yazdır</title></head><body>');
            printWindow.document.write('<table border="1" style="width:100%; text-align:left;">');
            printWindow.document.write('<tr>' + row + '</tr>');
            printWindow.document.write('</table>');
            printWindow.document.write('</body></html>');
            printWindow.document.close();

            // Yazdır
            printWindow.print();
        }
    </script>

    <div id="detailsModal" style="display:none; position:fixed; top:50%; left:50%; transform:translate(-50%, -50%); background:white; padding:20px; border:1px solid #ccc; box-shadow:0 4px 8px rgba(0,0,0,0.2);">
        <h3>Detaylar</h3>
        <div id="detailsContent"></div>
        <button onclick="closeModal()">Kapat</button>
    </div>


</body>
</html>