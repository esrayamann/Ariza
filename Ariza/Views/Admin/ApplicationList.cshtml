@model List<Talep>

@{
    ViewData["Title"] = "ApplicationList";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h1>Talepler </h1>

<form method="get">
    <div>
        <input type="text" name="searchString" placeholder="İsim Soyisim Ara" value="@Context.Request.Query["searchString"]" />
        <button type="submit">Ara</button>
    </div>
</form>

<div class="sort-links">
    <a href="@Url.Action("ApplicationList", new { sortOrder = ViewData["NameSortParm"] })">İsme Göre (A-Z)</a> |
    <a href="@Url.Action("ApplicationList", new { sortOrder = ViewData["name_desc"] })">İsme Göre (Z-A)</a> |
    <a href="@Url.Action("ApplicationList", new { sortOrder = ViewData["DateAscSortParm"] })">Tarihe Göre (Eski-Yeni)</a> |
    <a href="@Url.Action("ApplicationList", new { sortOrder = ViewData["DateSortParm"] })">Tarihe Göre (Yeni-Eski)</a>
</div>

<html>
<head>
    <style>
        table, td, th {
            border: 1px solid #ddd;
            text-align: left;
        }

        .sort-links {
            text-align: center;
            margin-bottom: 20px;
        }

            .sort-links a {
                color: #0056b3;
                text-decoration: none;
                margin: 0 10px;
                font-weight: bold;
            }

                .sort-links a:hover {
                    text-decoration: underline;
                }

        table {
            border-collapse: collapse;
            width: 80%; 
            margin: 20px auto; 
        }

        th, td {
            padding: 15px;
        }

        th {
            background-color: #f4f4f4;
        }

        tr:nth-child(even) {
            background-color: #f9f9f9;
        }

        tr:hover {
            background-color: #e0f7fa;
        }

        .container {
            margin-top: 30px;
            text-align: center;
        }
    </style>
</head>
<body>

    <div class="container">
        <table>
            <thead>
                <tr>
                    <th>Ad</th>
                    <th>Soyad</th>
                    <th>Email</th>
                    <th>Telefon Numarası</th>
                    <th>Arıza</th>
                    <th>Tarih</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var talep in Model)
                {
                    <tr>
                        <td>@talep.Ad</td>
                        <td>@talep.Soyad</td>
                        <td>@talep.Email</td>
                        <td>@talep.TelNo</td>
                        <td>@talep.Ariza</td>                      
                        <td>@talep.CreatedDate</td>                      
                    </tr>
                }
            </tbody>
        </table>
    </div>

</body>
</html>