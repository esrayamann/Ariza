@model ChangeRoleViewModel

@{
    ViewData["Title"] = "Rol Değiştir";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card shadow-lg border-0 rounded">
                <div class="card-header bg-primary text-white text-center">
                    <h4 class="mb-0">Rol Değiştir</h4>
                </div>
                <div class="card-body">
                    <form asp-action="ChangeRole" method="post">
                        <input type="hidden" asp-for="UserId" />

                        <div class="mb-3">
                            <label class="form-label fw-bold">Kullanıcı Adı</label>
                            <input type="text" class="form-control" value="@Model.Ad @Model.Soyad" disabled />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Mevcut Rol</label>
                            <input type="text" class="form-control" value="@Model.AvailableRoles.FirstOrDefault(r => r.Id == Model.CurrentRoleId)?.Rol" disabled />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Yeni Rol Seç</label>
                            <select asp-for="SelectedRoleId" class="form-select">
                                <option disabled selected>Bir rol seçin</option>
                                @foreach (var role in Model.AvailableRoles)
                                {
                                    <option value="@role.Id">@role.Rol</option>
                                }
                            </select>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-save me-2"></i> Güncelle
                            </button>
                            <a href="@Url.Action("UserList", "Admin")" class="btn btn-outline-secondary">
                                <i class="fas fa-arrow-left me-2"></i> Geri Dön
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
