@using Azure.Core
@model IEnumerable<Ariza.Models.Talep>

@{
    ViewData["Title"] = "Rapor";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h1>Rapor</h1>

<form method="get" asp-action="Rapor">
    <div>
        <label for="startDate">Başlangıç Tarihi:</label>
        <input type="date" id="startDate" name="startDate" value="@ViewData["StartDate"]" />
    </div>
    <div>
        <label for="endDate">Bitiş Tarihi:</label>
        <input type="date" id="endDate" name="endDate" value="@ViewData["EndDate"]" />
    </div>
    <button type="submit">Filtrele</button>
</form>

<table border="1" cellpadding="5" cellspacing="0" style="margin-top: 20px; width: 100%;">
    <thead>
        <tr>
            <th>Ad</th>
            <th>Soyad</th>
            <th>Arıza Açıklaması</th>
            <th>Bölüm</th>
            <th>Birim</th>
            <th>Oluşturulma Tarihi</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var talep in Model)
        {
            <tr>
                <td>@talep.Ad</td>
                <td>@talep.Soyad</td>
                <td>@talep.Ariza</td>
                <td>@talep.Bolum</td>
                <td>@talep.Birim</td>
                <td>@talep.CreatedDate.ToString("yyyy-MM-dd HH:mm:ss")</td>
            </tr>
        }
    </tbody>
</table>
