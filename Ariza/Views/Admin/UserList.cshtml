@model List<Ariza.Models.User>

@{
    ViewData["Title"] = "Kullanıcı Listesi";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Kullanıcı Listesi</h1>
        <a href="@Url.Action("CreateUser", "Admin")" class="btn btn-primary">
            <i class="fas fa-plus me-2"></i>Yeni Kullanıcı
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Ad</th>
                            <th>Soyad</th>
                            <th>Email</th>
                            <th>İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td>@user.Id</td>
                                <td>@user.Ad</td>
                                <td>@user.Soyad</td>
                                <td>@user.Email</td>
                                <td>
                                    <a href="@Url.Action("ChangeRole", "Admin", new { userId = user.Id })" class="btn btn-outline-primary btn-sm">
                                        <i class="fas fa-user-edit me-1"></i> Rol Değiştir
                                    </a>
                                </td>

                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function changeRole(userId) {
            window.location.href = '@Url.Action("ChangeRole", "Admin")/' + userId;
        }
    </script>
}
